{
  "name": "omp-studio",
  "private": true,
  "version": "0.3.33",
  "description": "Browser workspace for the local omp coding agent: real sessions, tools, files, models and skills.",
  "license": "Apache-2.0",
  "author": "Shang-1999",
  "homepage": "https://github.com/Shang-1999/OMP-WebUI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shang-1999/OMP-WebUI.git"
  },
  "bugs": {
    "url": "https://github.com/Shang-1999/OMP-WebUI/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "coding-agent",
    "web-ui",
    "react",
    "vite",
    "express",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "omp-studio": "bin/omp-studio.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server.ts",
    "index.html",
    ".env.example",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "dev:ui": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "tsx server.ts --prod",
    "test:e2e": "node scripts/e2e-omp.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "prepare": "vite build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
