# Workspace runtime data — skills installed per project (the Agent Skills CLI
# writes .agents/, the other agents' dirs and its lock file), and the bridge's
# project-scope extension pins: machine state, not app source.
.agents/
.omp/
.claude/
skills-lock.json
# Agent-directory copies: the Agent Skills CLI writes one per agent when it is
# not pinned with `-a pi` (data/, skills/ and ~45 dot-directories).
data/
skills/

# Local safety copies of user-supplied art (never committed).
.assets-backup/
